<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003" ToolsVersion="4.0">
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <SchemaVersion>2.0</SchemaVersion>
    <ProjectGuid>{395A70F2-5AB1-42FB-B1C0-53D9964EDB80}</ProjectGuid>
    <ProjectHome>.</ProjectHome>
    <Name>mpagent</Name>
    <RootNamespace>mpagent</RootNamespace>
    <OutputPath>.</OutputPath>
    <!-- F5 runs the full pipeline for this input folder, from the CodeBase folder (ARCHITECTURE.md D16, D17) -->
    <StartupFile>src\mpagent\cli.py</StartupFile>
    <CommandLineArguments>inputs/pid-connector-exporter</CommandLineArguments>
    <WorkingDirectory>.</WorkingDirectory>
    <SearchPath>src</SearchPath>
    <!-- Use the project's own .venv (created by uv) -->
    <InterpreterId>MSBuild|venv|$(MSBuildProjectFullPath)</InterpreterId>
    <TestFramework>Pytest</TestFramework>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DebugSymbols>true</DebugSymbols>
    <EnableUnmanagedDebugging>false</EnableUnmanagedDebugging>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <DebugSymbols>true</DebugSymbols>
    <EnableUnmanagedDebugging>false</EnableUnmanagedDebugging>
  </PropertyGroup>
  <ItemGroup>
    <Interpreter Include=".venv\">
      <Id>venv</Id>
      <Version>3.12</Version>
      <Description>.venv (Python 3.12, managed by uv)</Description>
      <InterpreterPath>Scripts\python.exe</InterpreterPath>
      <WindowsInterpreterPath>Scripts\pythonw.exe</WindowsInterpreterPath>
      <PathEnvironmentVariable>PYTHONPATH</PathEnvironmentVariable>
      <Architecture>X64</Architecture>
    </Interpreter>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="src\**\*.py" />
    <Compile Include="tests\**\*.py" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="pyproject.toml" />
    <Content Include="README.md" />
    <Content Include=".env" />
    <Content Include="inputs\**\*.txt" />
    <Content Include="inputs\README.md" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="inputs\" />
    <Folder Include="inputs\pid-connector-exporter\" />
    <Folder Include="inputs\pid-connector-importer\" />
    <Folder Include="inputs\tiny-tools\" />
    <Folder Include="src\" />
    <Folder Include="src\mpagent\" />
    <Folder Include="src\mpagent\design\" />
    <Folder Include="src\mpagent\execute\" />
    <Folder Include="tests\" />
  </ItemGroup>
  <Import Project="$(MSBuildExtensionsPath32)\Microsoft\VisualStudio\v$(VisualStudioVersion)\Python Tools\Microsoft.PythonTools.targets" />
</Project>