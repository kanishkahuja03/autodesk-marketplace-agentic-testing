# Copy to .env and fill in. Keep .env private: it is git-ignored.

# OpenAI (enterprise key from platform.openai.com); one model for both agents (ARCHITECTURE.md D34)
OPENAI_API_KEY=
OPENAI_MODEL=

# Keep traces local (ARCHITECTURE.md D11)
OPENAI_AGENTS_DISABLE_TRACING=1

# Agent 2 limits (ARCHITECTURE.md D29)
AGENT2_MAX_TURNS=150
AGENT2_TOOL_TIMEOUT_S=120
AGENT2_TIMEOUT_MIN=40

# Agent 2's reasoning effort (none, minimal, low, medium, high, xhigh, max); empty = the model's default.
# Lower answers each step faster; check that the verdicts stay the same.
AGENT2_REASONING_EFFORT=

# Agent 2 finds, clicks and types UI elements by name (fast); Windows-MCP stays the fallback.
# false = exactly the behaviour before these tools (UI_FIND_TOOLS_PLAN.md)
AGENT2_UI_FIND_TOOLS=true

# FUNC tests (FUNC_TESTS_PLAN.md F15, F18): extra time and turns per FUNC test, added to the limits above
AGENT2_FUNC_MIN_PER_TEST=10
AGENT2_FUNC_TURNS_PER_TEST=40
# TEMPORARY (POC): one sample for features that need content: a file or a folder (e.g. a project). Empty = none
SAMPLES_DIR=

# Output files the judge reads per claim, all files together, in characters; 0 or empty = no limit, the whole
# file (FUNC_TESTS_PLAN.md F17). A large file costs many tokens per claim.
JUDGE_FILE_EXCERPT_CHARS=0

# Screenshots the judge sees per claim: the ones Agent 2 named first, then the latest (FUNC_TESTS_PLAN.md F17)
JUDGE_MAX_IMAGES=6

# Pre-installed Windows-MCP command (ARCHITECTURE.md D21)
WINDOWS_MCP_COMMAND=windows-mcp
